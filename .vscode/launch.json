{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Next.js: debug server-side",
      "type": "node-terminal",
      "request": "launch",
      "command": "bun",
      "args": ["run", "dev"],
      "cwd": "${workspaceFolder}",
      "env": {
        "NODE_OPTIONS": "--inspect"
      },
      "console": "integratedTerminal",
      "presentation": {
        "group": "1",
        "order": 1
      }
    },
    {
      "name": "Next.js: debug client-side",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "webpack:///src/*": "${webRoot}/*"
      },
      "presentation": {
        "group": "1",
        "order": 2
      }
    },
    {
      "name": "Next.js: debug full stack",
      "type": "node-terminal",
      "request": "launch",
      "command": "bun",
      "args": ["run", "dev"],
      "cwd": "${workspaceFolder}",
      "env": {
        "NODE_OPTIONS": "--inspect"
      },
      "console": "integratedTerminal",
      "presentation": {
        "group": "2",
        "order": 1
      },
      "preLaunchTask": "type-check"
    }
  ],
  "compounds": [
    {
      "name": "Launch Full Stack Debug",
      "configurations": [
        "Next.js: debug server-side",
        "Next.js: debug client-side"
      ],
      "presentation": {
        "group": "2",
        "order": 2
      }
    }
  ]
}